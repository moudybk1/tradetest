# Copy to .env and fill in. Never commit .env.

# Claude API key (for the AI agent filter): https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Hyperliquid ---
# Your MAIN wallet address (the account that holds the USDC).
HL_ACCOUNT_ADDRESS=
# Private key of an API wallet created at https://app.hyperliquid.xyz/API
# An API wallet can trade but can NOT withdraw funds. Never use your main wallet key here.
HL_API_PRIVATE_KEY=

# --- MetaTrader 5 (leave empty to use the account already logged in to the terminal) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

//@version=5
// XAU IFVG + Hammer, RR 1:2 - TradingView version of the bot's `ifvg_hammer` strategy.
// Same rules as xau_agent/strategy.py (both directions):
//   LONG : hammer at a swing low, then within N candles a candle CLOSES above a bearish FVG
//          (the gap is inverted = IFVG) -> buy at that close.
//   SHORT: shooting star at a swing high, then a close below a bullish FVG -> sell.
//   Stop just beyond the hammer / star (+ buffer), target = RR x stop. One position at a time,
//   max trades per UTC day, everything closed at 20:30 UTC.
// How to use: Pine Editor -> paste -> "Add to chart" -> open "Strategy Tester".
// Commission is set in Properties (default 0.055% per side = Bybit non-VIP taker fee).
strategy("XAU IFVG + Hammer RR", overlay=true, initial_capital=10000,
     default_qty_type=strategy.fixed, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.055,
     process_orders_on_close=true, max_bars_back=500)

// ---- inputs ----------------------------------------------------------------------------------
qty          = input.float(10, "Quantity (oz / contracts; 0.1 lot = 10 oz)", minval=0.001)
pipSize      = input.float(0.10, "Pip size (XAUUSD: 0.10)")
rr           = input.float(2.0, "Reward : risk", minval=0.1)
bufferPips   = input.float(3, "Stop buffer beyond hammer (pips)")
minStopPips  = input.float(10, "Min stop (pips)")
maxStopPips  = input.float(100, "Max stop (pips) - wider signals are skipped")
sess1        = input.session("0700-1100", "Session 1 (UTC)")
sess2        = input.session("1300-1700", "Session 2 (UTC)")
maxTrades    = input.int(2, "Max trades per UTC day", minval=1)
flattenMin   = input.int(1230, "Close everything at (UTC minutes after midnight, 1230 = 20:30)")
fvgLookback  = input.int(30, "FVG lookback (candles)")
minFvgPips   = input.float(3, "Min FVG size (pips)")
hammerBars   = input.int(6, "IFVG must come within N candles after the hammer")
wickRatio    = input.float(2.0, "Hammer: long wick >= x body")
maxOppWick   = input.float(0.25, "Hammer: other wick <= x candle range")
minRangePips = input.float(5, "Hammer: min candle range (pips)")
swingBars    = input.int(10, "Hammer low = lowest of last N candles (0 = off)")
allowLong    = input.bool(true, "Longs")
allowShort   = input.bool(true, "Shorts")

// ---- hammer / shooting star -------------------------------------------------------------------
rng      = high - low
body     = math.abs(close - open)
lowerW   = math.min(open, close) - low
upperW   = high - math.max(open, close)
bigEnough = rng >= minRangePips * pipSize
lowestN  = ta.lowest(low, math.max(swingBars, 1))
highestN = ta.highest(high, math.max(swingBars, 1))
isHammer = bigEnough and lowerW >= wickRatio * body and upperW <= maxOppWick * rng and (swingBars == 0 or low <= lowestN)
isStar   = bigEnough and upperW >= wickRatio * body and lowerW <= maxOppWick * rng and (swingBars == 0 or high >= highestN)

// Most recent hammer / star; it stops counting once its low / high is broken.
var float hLow  = na
var int   hBar  = na
var float sHigh = na
var int   sBar  = na
if isHammer
    hLow := low
    hBar := bar_index
else if not na(hLow) and low < hLow
    hLow := na
    hBar := na
if isStar
    sHigh := high
    sBar  := bar_index
else if not na(sHigh) and high > sHigh
    sHigh := na
    sBar  := na
hammerOk = not na(hLow) and bar_index - hBar <= hammerBars
starOk   = not na(sHigh) and bar_index - sBar <= hammerBars

// ---- FVG -> IFVG ----------------------------------------------------------------------------------
var bearTop = array.new_float()
var bearBar = array.new_int()
var bullBot = array.new_float()
var bullBar = array.new_int()
minGap = minFvgPips * pipSize

// 1) forget old gaps
if array.size(bearBar) > 0
    for j = array.size(bearBar) - 1 to 0
        if bar_index - array.get(bearBar, j) > fvgLookback
            array.remove(bearTop, j)
            array.remove(bearBar, j)
if array.size(bullBar) > 0
    for j = array.size(bullBar) - 1 to 0
        if bar_index - array.get(bullBar, j) > fvgLookback
            array.remove(bullBot, j)
            array.remove(bullBar, j)

// 2) inversions: this candle closes through an earlier gap
ifvgLong = false
ifvgShort = false
if array.size(bearBar) > 0
    for j = array.size(bearBar) - 1 to 0
        if close > array.get(bearTop, j)
            ifvgLong := true
            array.remove(bearTop, j)
            array.remove(bearBar, j)
if array.size(bullBar) > 0
    for j = array.size(bullBar) - 1 to 0
        if close < array.get(bullBot, j)
            ifvgShort := true
            array.remove(bullBot, j)
            array.remove(bullBar, j)

// 3) new gaps completed by this candle (candle 3 of the pattern)
if bar_index >= 2
    if low[2] - high >= minGap
        array.push(bearTop, low[2])
        array.push(bearBar, bar_index)
    if low - high[2] >= minGap
        array.push(bullBot, high[2])
        array.push(bullBar, bar_index)

// ---- session / day bookkeeping ---------------------------------------------------------------
inSession = not na(time(timeframe.period, sess1, "UTC")) or not na(time(timeframe.period, sess2, "UTC"))
dow = dayofweek(time, "UTC")
weekday = dow != dayofweek.saturday and dow != dayofweek.sunday
closeMinute = hour(time_close, "UTC") * 60 + minute(time_close, "UTC")
var int tradesToday = 0
var int dayKey = na
thisDay = math.floor(time / 86400000)
if na(dayKey) or thisDay != dayKey
    dayKey := thisDay
    tradesToday := 0

canTrade = inSession and weekday and strategy.position_size == 0 and tradesToday < maxTrades

// ---- entries ---------------------------------------------------------------------------------
buffer = bufferPips * pipSize
minStop = minStopPips * pipSize
maxStop = maxStopPips * pipSize

if canTrade and allowLong and ifvgLong and not ifvgShort and hammerOk
    stopL = math.min(hLow - buffer, close - minStop)
    risk = close - stopL
    if risk <= maxStop
        strategy.entry("Long", strategy.long, qty=qty)
        strategy.exit("Long exit", "Long", stop=stopL, limit=close + rr * risk)
        tradesToday += 1
else if canTrade and allowShort and ifvgShort and not ifvgLong and starOk
    stopS = math.max(sHigh + buffer, close + minStop)
    risk = stopS - close
    if risk <= maxStop
        strategy.entry("Short", strategy.short, qty=qty)
        strategy.exit("Short exit", "Short", stop=stopS, limit=close - rr * risk)
        tradesToday += 1

// End of session: never hold into the rollover / overnight.
if strategy.position_size != 0 and closeMinute >= flattenMin
    strategy.close_all(comment="20:30 UTC flatten")

plotshape(isHammer, "Hammer", shape.triangleup, location.belowbar, color.new(color.teal, 0), size=size.tiny)
plotshape(isStar, "Shooting star", shape.triangledown, location.abovebar, color.new(color.orange, 0), size=size.tiny)
plotshape(ifvgLong, "Bullish IFVG", shape.circle, location.belowbar, color.new(color.green, 40), size=size.tiny)
plotshape(ifvgShort, "Bearish IFVG", shape.circle, location.abovebar, color.new(color.red, 40), size=size.tiny)
